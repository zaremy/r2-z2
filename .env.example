# Copy to .env and fill in. NEVER commit .env.
# On the ESP32 these become NVS-provisioned values, not files.

# --- Cloud reasoning provider (swappable — see docs/intent.md) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Speech-to-text (phase: later, not phase zero) ---
STT_PROVIDER=
STT_API_KEY=

# --- Wake word (S2 V1, #42) ---
# The engine is a seam, not a vendor choice baked into the code (voice/wake.py).
#   openwakeword — no key, no account. Code Apache-2.0, models CC BY-NC-SA 4.0.
#   porcupine    — needs PICOVOICE_ACCESS_KEY below.
WAKE_ENGINE=openwakeword
# The phrase is "z2". No free engine ships a stock model for it, so it must be
# trained once — see mac-prototype/voice/README.md. Leave blank to use the
# packaged default path (voice/models/z2.onnx), or name a stock model such as
# hey_jarvis to smoke-test the pipeline before training.
WAKE_KEYWORD=

# Picovoice discontinued its Free Tier on 2026-06-30 and its FAQ states there
# are "no dedicated free or paid plans for personal or non-commercial use".
# Leave blank unless you hold a paid AccessKey.
PICOVOICE_ACCESS_KEY=

# --- Threepio's voice (S2 V6, #47) ---
# R2 never speaks. C-3PO rides in the backpack and does the talking (D-011).
# Leave TTS_API_KEY blank when TTS_PROVIDER == LLM_PROVIDER: the same key is
# reused, so you never paste it twice. Different providers never share a key.
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE=ash

# --- Wi-Fi for the backpack (provisioned on device, here for dev only) ---
WIFI_SSID=
WIFI_PASSWORD=

# --- Optional: pin a specific robot instead of first D2-* found ---
R2_NAME=
