# Copy to .env and fill in. NEVER commit .env.
# On the ESP32 these become NVS-provisioned values, not files.

# --- Cloud reasoning provider (swappable — see docs/intent.md) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Speech-to-text (phase: later, not phase zero) ---
STT_PROVIDER=
STT_API_KEY=

# --- Wi-Fi for the backpack (provisioned on device, here for dev only) ---
WIFI_SSID=
WIFI_PASSWORD=

# --- Optional: pin a specific robot instead of first D2-* found ---
R2_NAME=
