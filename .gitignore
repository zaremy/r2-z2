# Upstream clones kept locally for easy reference — never vendored into our
# history. Restore with the commands in README.md; SHAs in docs/research/source-map.md
reference/

# Obsidian vault — local durable KB / governance notes, not project source
R2Z2-vault/

# Secrets
.env
*.env
!.env.example
secrets.json
wifi_credentials.h

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ESP-IDF / PlatformIO
build/
managed_components/
sdkconfig
sdkconfig.old
dependencies.lock
.pio/

# macOS
.DS_Store

# Local scratch
scratch/
*.log

# Generated launcher bundle — rebuild with `mac-prototype/r2 --rebuild`
mac-prototype/tools/R2Probe.app/

# Bridge daemon queue — runtime only
mac-prototype/.bridge/

# Survey harness state — runtime only
mac-prototype/.survey/

# Character state — happiness and anything that joins it (#85). Runtime, and
# deliberately NOT device state: it is about how R2 has been treated, not
# about the hardware, and it must not travel between machines in git.
mac-prototype/.state/

# Audio/media test material — large binaries, not project source
testing/

# Wake-word models — third-party binaries, FETCHED not vendored. r2d2.onnx is
# MIT from fwartner/home-assistant-wakewords-collection; z2.onnx is trained.
# Fetch/training instructions: mac-prototype/voice/README.md
mac-prototype/voice/models/*.onnx
mac-prototype/voice/models/*.tflite

# Per-arm build dirs for firmware/coex_check
build-arm*/

# Wi-Fi credentials for the A1 coexistence arms — never commit
firmware/**/wifi_creds.h

# ...but a firmware experiment's lock can BE its evidence: it pins the exact
# component versions a published finding rests on. Name those files one by one.
# A `firmware/**/dependencies.lock` wildcard was tried first and was too broad --
# it un-ignored every app's lock, so ordinary build artifacts (sd_check's, for
# one) turned up as untracked noise in every session's `git status`.
!firmware/brookesia_check/dependencies.lock
